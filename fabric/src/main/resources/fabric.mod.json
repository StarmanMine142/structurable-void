{
  "schemaVersion": 1,
  "id": "structurablevoid",
  "version": "${version}",
  "name": "Structurable Void",
  "description": "Client side mod to make using the block Structure Void easier.",
  "authors": [
    "VgLevelUp"
  ],
  "contributors": [
    "StarmanMine142"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/structurable-void",
    "sources": "https://github.com/StarmanMine142/structurable-void",
    "issues": "https://github.com/StarmanMine142/structurable-void/issues"
  },
  "license": "MIT",
  "icon": "assets/structurablevoid/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.vg.structurablevoid.fabric.StructurableVoidFabric"
    ],
    "client": [
      "net.vg.structurablevoid.fabric.client.StructurableVoidFabricClient"
    ],
    "modmenu": [
      "net.vg.structurablevoid.fabric.modmenu.StructurableVoidModMenu"
    ]
  },
  "mixins": [
    "structurablevoid.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~${min_minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
